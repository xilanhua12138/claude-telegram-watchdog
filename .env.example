# Working directory where Claude Code runs
WORK_DIR=/path/to/your/project

# Proxy (optional, remove if not needed)
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ── Advanced (rarely need to change) ─────────────
# CLAUDE_BIN=~/.local/bin/claude
# TELEGRAM_CHANNEL=plugin:telegram@claude-plugins-official
# TELEGRAM_ENV_FILE=~/.claude/channels/telegram/.env
# CLAUDE_AUTOCOMPACT_PCT=50
# CLAUDE_EXTRA_FLAGS=
# CHECK_INTERVAL=60
# MAX_FAILURES=5
# RESTART_DELAY=10
# LOG_DIR=./logs
# LOG_MAX_BYTES=5242880
# TMUX_SESSION=claude-telegram
